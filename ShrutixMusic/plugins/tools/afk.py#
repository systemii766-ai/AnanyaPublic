# =============================================================
#       Auto Remove AFK + Tag/Reply AFK Notify
# =============================================================

@nand.on_message(~filters.me & ~filters.bot & ~filters.via_bot)
async def afk_auto(_, message: Message):
    user = message.from_user
    if not user:
        return

    user_id = user.id
    name = user.first_name.lower().title()

    # -----------------------
    #   User sends message → AFK remove
    # -----------------------
    check, data = await is_afk(user_id)
    if check:
        await remove_afk(user_id)
        ago = get_readable_time(int(time.time() - data["time"]))

        msg = f"❖ Welcome back {name}!\n"
        msg += f"● You were away for: {ago}"
        if data["reason"]:
            msg += f"\n● Reason: {data['reason'].lower()}"

        await message.reply_text(msg)

    # -----------------------
    #   Check AFK user in reply
    # -----------------------
    if message.reply_to_message:
        r = message.reply_to_message.from_user
        if r:
            r_check, r_data = await is_afk(r.id)
            if r_check:
                ago = get_readable_time(int(time.time() - r_data["time"]))

                msg = f"❖ {r.first_name.lower().title()} is afk!\n"
                msg += f"● Since: {ago}"
                if r_data["reason"]:
                    msg += f"\n● Reason: {r_data['reason'].lower()}"

                await message.reply_text(msg)
              
